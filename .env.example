# Configuração local. Copie este arquivo para .env se quiser alterar a porta/host.
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Opcional: para provisionar a conta da professora pelo servidor, descomente e configure
# estas duas variáveis com valores próprios. Se ficarem vazias, a professora poderá
# criar a primeira conta pela aba “Professora”, no próprio computador do servidor.
# TEACHER_USERNAME=professora
# TEACHER_PASSWORD=use-uma-senha-forte-e-unica
